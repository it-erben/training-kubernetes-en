# Terraform state (contains sensitive data)
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Terraform directory (provider binaries)
.terraform/

# Crash logs
crash.log
crash.*.log

# Variable files (may contain secrets)
*.tfvars
!terraform.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc

# Plan files
*.tfplan
tfplan

# macOS
.DS_Store
